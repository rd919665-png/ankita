rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'ripan321321@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Business Settings (Public read, admin write)
    match /businessSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingsId);
    }

    // Services Catalog (Public read, admin write)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(serviceId);
    }

    // Packages Catalog (Public read, admin write)
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(packageId);
    }

    // Portfolio items (Public read, admin write)
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(portfolioId);
    }

    // Offers & banners (Public read, admin write)
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(offerId);
    }

    // Coupons (Public read, admin write)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(couponId);
    }

    // Reviews
    match /reviews/{reviewId} {
      allow get: if (resource.data.isApproved == true) || isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow list: if (resource.data.isApproved == true) || isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(reviewId) && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(bookingId) && request.resource.data.customerId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.customerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['specialInstructions', 'venue', 'updatedAt'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(paymentId) && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']);
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
